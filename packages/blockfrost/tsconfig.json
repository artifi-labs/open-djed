{
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noEmit": false,
    "customConditions": ["imports", "require", "default"],
    "composite": true
  },
  "include": ["src", "__tests__", "*.ts"]
}
