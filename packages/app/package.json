{
  "name": "@open-djed/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "format": "prettier --write .",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "locales-extract": "bunx i18next-parser",
    "translate": "bunx @inlang/cli machine translate --project ./project.inlang",
    "translate:validate": "bunx @inlang/cli validate --project ./project.inlang"
  },
  "dependencies": {
    "@dcspark/cardano-multiplatform-lib-browser": "^6.2.0",
    "@floating-ui/react": "^0.27.19",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@lucid-evolution/lucid": "^0.4.31",
    "@open-djed/api": "workspace:*",
    "@open-djed/blockfrost": "workspace:*",
    "@open-djed/math": "workspace:*",
    "@open-djed/registry": "workspace:*",
    "@open-djed/txs": "workspace:*",
    "@opennextjs/cloudflare": "^1.19.11",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.100.11",
    "cbor2": "^1.12.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "framer-motion": "^12.39.0",
    "hono": "^4.12.21",
    "isbot": "^5.1.40",
    "json-bigint": "^1.0.0",
    "next": "15.5.9",
    "next-intl": "^4.12.0",
    "posthog-js": "^1.374.2",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-icons": "^5.6.0",
    "react-responsive": "^10.0.1",
    "recharts": "^3.8.1",
    "usehooks-ts": "^3.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.5.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.93.0"
  }
}
